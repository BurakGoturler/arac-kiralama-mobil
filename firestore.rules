rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
//  Şenbayrak Araç Kiralama — Firestore Güvenlik Kuralları
//
//  Temel ilke: Varsayılan olarak her şey yasak. İzinler tek tek verilir.
//  Bu dosya projenin kaynak kodunun parçasıdır; konsoldan elle
//  değiştirilmemeli, değişiklikler burada yapılıp deploy edilmelidir:
//
//      firebase deploy --only firestore:rules
// ═══════════════════════════════════════════════════════════════════

// 07.09.2026 — Bu satır, kuralların canlıya gerçekten yüklendiğini
// doğrulamak için eklendi. CLI, dosya içeriği yüklü sürümle aynı
// göründüğünde yüklemeyi atlıyor ("already up to date, skipping upload");
// bu durumda canlıdaki kuralın dosyayla aynı olduğu DOĞRULANAMIYOR.
// İçerik değiştiği için bu dağıtım atlanamaz ve gerçekten yüklenir.
//
// Belirti: vehicles koleksiyonuna kimliksiz okuma isteği 403
// PERMISSION_DENIED dönüyor; oysa aşağıdaki kural bu okumayı herkese
// açıyor (allow read: if true). App Check zorlaması kapalı, veritabanı
// tek ve (default), Native modda.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Yardımcı fonksiyonlar ────────────────────────────────────

    function girisYapmis() {
      return request.auth != null;
    }

    // Rezervasyon gibi kritik işlemler için e-posta doğrulaması şart.
    function dogrulanmis() {
      return girisYapmis() && request.auth.token.email_verified == true;
    }

    // Yönetici kontrolü.
    // Önce Custom Claim'e bakılır (ileride atanırsa ek okuma maliyeti olmaz),
    // yoksa users dokümanındaki role alanına düşülür.
    // Bu güvenlidir çünkü aşağıdaki kurallar kullanıcının kendi role alanını
    // değiştirmesini kesin olarak engeller.
    function yonetici() {
      return girisYapmis() && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function kendisi(uid) {
      return girisYapmis() && request.auth.uid == uid;
    }

    // ── users ────────────────────────────────────────────────────
    // Kullanıcı yalnızca kendi profilini görür ve düzenler.
    // Yönetici tüm profilleri okuyabilir ama düzenleyemez.
    match /users/{uid} {

      allow read: if kendisi(uid) || yonetici();

      // Kayıt anında oluşturma: yalnızca kendi dokümanını, rolü 'customer'
      // olarak oluşturabilir. Kendini yönetici yapması engellenir.
      //
      // sozlesmeOnayi == true şartı, aydınlatma metni onayı alınmadan
      // hesap açılamamasını sunucu tarafında garanti eder (KVKK — ispat yükü).
      //
      // T.C. Kimlik Numarası bu koleksiyonda hiç saklanmadığı için
      // ilgili bir alan da beklenmez.
      //
      // 14.09.2026 — 'acikRizaVerildi is bool' şartı kaldırıldı: uygulamada
      // rızaya dayanan işleme kalmadı, alan artık yazılmıyor.
      allow create: if kendisi(uid)
                    && request.resource.data.role == 'customer'
                    && request.resource.data.sozlesmeOnayi == true
                    // 14.09.2026 — Kurul 2026/347: aydınlatma için yalnızca
                    // "okudum" geri bildirimi alınır ve sözleşme kabulünden
                    // ayrı tutulur. İkisi de üyelik için zorunlu.
                    && request.resource.data.aydinlatmaOkundu == true
                    // Kampanya onayı isteğe bağlıdır; verildiyse tarihi
                    // sunucu saatiyle yazılmak zorundadır (ispat).
                    && (
                      !('kampanyaOnayi' in request.resource.data)
                      || request.resource.data.kampanyaOnayi == false
                      || request.resource.data.kampanyaOnayTarihi == request.time
                    )
                    && request.resource.data.email is string
                    && request.resource.data.name is string
                    && request.resource.data.surname is string
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.surname.size() <= 60
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 20;

      // Güncelleme: role alanı KESİNLİKLE değiştirilemez.
      // Bu satır, yönetici yetkisinin tüm güvenlik temelidir.
      allow update: if kendisi(uid)
                    && request.resource.data.role == resource.data.role
                    && (
                      !('favoriteVehicleIds' in request.resource.data) ||
                      request.resource.data.favoriteVehicleIds.size() <= 200
                    )
                    // Kampanya onayı değişiyorsa, verme veya geri alma
                    // tarihi sunucu saatiyle yazılmak zorundadır. Onay ve
                    // ret anı İYS kaydının ve ispatın dayanağıdır; istemcinin
                    // geçmiş ya da ileri bir tarih yazması engellenir.
                    && (
                      !('kampanyaOnayi' in request.resource.data)
                      || request.resource.data.kampanyaOnayi == resource.data.get('kampanyaOnayi', false)
                      || (request.resource.data.kampanyaOnayi == true
                          && request.resource.data.kampanyaOnayTarihi == request.time)
                      || (request.resource.data.kampanyaOnayi == false
                          && request.resource.data.kampanyaRetTarihi == request.time)
                    );

      // Hesap silme (KVKK m.7 — silme hakkı). Kullanıcı kendi kaydını siler.
      allow delete: if kendisi(uid);
    }

    // ── vehicles / campaigns / pickup_locations ──────────────────
    // Herkes okuyabilir (misafir kullanıcılar araçlara göz atabilmeli).
    // Yalnızca yönetici yazabilir.
    match /vehicles/{id} {
      allow read: if true;
      allow write: if yonetici();
    }

    match /campaigns/{id} {
      allow read: if true;
      allow write: if yonetici();
    }

    match /pickup_locations/{id} {
      allow read: if true;
      allow write: if yonetici();
    }

    // ── blog_posts — bilgilendirme yazıları ──────────────────────
    // Yayındaki yazıları herkes okur; taslakları yalnızca yönetici görür.
    // Kişisel veri içermez. İstemci sorgusu `isPublished == true` şartını
    // taşımak zorundadır, aksi hâlde misafir sorgusu bütünüyle reddedilir.
    match /blog_posts/{id} {
      allow read: if resource.data.isPublished == true || yonetici();

      allow create, update: if yonetici()
                    && request.resource.data.keys().hasOnly([
                         'title', 'summary', 'content', 'coverImageUrl',
                         'isPublished', 'createdAt', 'updatedAt', 'publishedAt'])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.summary is string
                    && request.resource.data.summary.size() <= 300
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 20000
                    && request.resource.data.coverImageUrl is string
                    && request.resource.data.isPublished is bool;

      allow delete: if yonetici();
    }

    // ── whatsapp_logs — rezervasyon talep kayıtları ──────────────
    // ÖNEMLİ: Denetim öncesinde bu koleksiyona kimlik doğrulaması
    // olmadan kayıt eklenebiliyordu. Aşağıdaki kurallar bunu kapatır.
    //
    // 14.09.2026 — Şirket kararı: kiralama talepleri YALNIZCA WhatsApp'tan
    // alınır. Bu koleksiyon, WhatsApp'a yönlendirilen taleplerin yönetim
    // paneli takip kaydıdır; 'kanal' her zaman 'whatsapp'tır.
    //
    // AÇIK RIZA ŞARTI KALDIRILDI. WhatsApp tek kanal olunca aktarım rızaya
    // dayanamaz (rıza hizmet şartı olur ve geçersizdir — avukat KVKK
    // analizi 02 numaralı bulgu). Dayanak Kurul standart sözleşmesidir
    // (WhatsApp Business Veri Aktarım Eki). Rıza şartını kuralda bırakmak,
    // rıza vermeyen herkesi kiralamadan tamamen dışlardı.
    match /whatsapp_logs/{id} {

      // Yalnızca yönetici okuyabilir; kullanıcı kendi kayıtlarını görebilir.
      allow read: if yonetici()
                  || (girisYapmis() && resource.data.userId == request.auth.uid);

      // Oluşturma: e-postası doğrulanmış kullanıcı, YALNIZCA kendi adına.
      //
      // T.C. Kimlik Numarası kaydedilmediği için 'customerTc' alanının
      // yazılması açıkça yasaklanır; ileride yanlışlıkla eklenmesi hâlinde
      // yazma işlemi reddedilir.
      allow create: if dogrulanmis()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && !('customerTc' in request.resource.data)
                    && request.resource.data.kanal == 'whatsapp'
                    && request.resource.data.vehicleName is string
                    && request.resource.data.vehicleName.size() <= 120
                    && request.resource.data.customerName.size() <= 60
                    && request.resource.data.customerSurname.size() <= 60
                    && request.resource.data.customerPhone.size() <= 20
                    && request.resource.data.pickupLocation.size() <= 120
                    && request.resource.data.keys().size() <= 15;

      // Kayıtlar sonradan değiştirilemez.
      allow update: if false;

      // Silme: yönetici (imha politikası) veya kaydın sahibi.
      // Sahibin silebilmesi, hesap silme akışının KVKK m.7 kapsamında
      // kişisel verileri geride bırakmaması için gereklidir.
      allow delete: if yonetici()
                    || (girisYapmis() && resource.data.userId == request.auth.uid);
    }

    // ── imha_kayitlari — İmha Yönetmeliği m.7/3 ──────────────────
    // Her silme/imha işleminin kaydı. Kayıtlar DEĞİŞTİRİLEMEZ ve en az
    // 3 yıl dolmadan SİLİNEMEZ; aksi hâlde imhanın yapıldığı ispat edilemez.
    //
    // İki tür kayıt var ve alanları kesin olarak sınırlıdır:
    //   'periyodik'   → yönetim panelinden, yalnızca yönetici; işlemi yapan
    //                   yöneticinin uid'si kendi kimliğiyle eşleşmek zorunda.
    //   'hesap_silme' → kullanıcının kendi hesabını silmesi. MÜŞTERİ KİŞİSEL
    //                   VERİSİ İÇEREMEZ: uid, e-posta, ad yazılamaz; yalnızca
    //                   tür, tarih ve silinen talep sayısı.
    match /imha_kayitlari/{id} {
      allow read: if yonetici();

      allow create: if (
                      yonetici()
                      && request.resource.data.tur == 'periyodik'
                      && request.resource.data.keys().hasOnly([
                           'tur', 'tarih', 'kategori', 'saklamaSuresiGun',
                           'sinirTarihi', 'silinenKayitSayisi', 'yapanUid'])
                      && request.resource.data.tarih == request.time
                      && request.resource.data.yapanUid == request.auth.uid
                      && request.resource.data.silinenKayitSayisi is int
                    ) || (
                      girisYapmis()
                      && request.resource.data.tur == 'hesap_silme'
                      && request.resource.data.keys().hasOnly([
                           'tur', 'tarih', 'silinenTalepSayisi'])
                      && request.resource.data.tarih == request.time
                      && request.resource.data.silinenTalepSayisi is int
                    );

      allow update: if false;

      // 3 yıllık asgari süre dolduktan sonra yönetici silebilir.
      allow delete: if yonetici()
                    && resource.data.tarih < request.time - duration.value(1095, 'd');
    }

    // ── Diğer her şey ────────────────────────────────────────────
    // Yeni bir koleksiyon eklendiğinde kural yazılmadığı sürece erişilemez.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
